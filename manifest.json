{
  "manifest_version": 2,
  "name": "Phoenity Icons",
  "description": "Phoenity Icons for Thunderbird",
  "version": "3.21",
  "author": "Dillinger",
  "homepage_url": "https://addons.phoenity.nl/",
  "experiment_apis": {
    "WindowListener": {
      "schema": "api/WindowListener/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["WindowListener"]],
        "script": "api/WindowListener/implementation.js"
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "icons@dillinger",
      "update_url": "https://addons.phoenity.nl/updates.txt",
      "strict_min_version": "128.0",
      "strict_max_version": "159.*"
    }
  },
  "theme_experiment": {
    "stylesheet": "icons.css"
  },
  "icons": {
    "32": "phoenityIcons32.png",
    "64": "phoenityIcons64.png"
  }
}
